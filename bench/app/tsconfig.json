{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": false,
    "baseUrl": ".",
    "paths": {
      "@": ["../../repos/bklit-ui/packages/ui/src"],
      "@/*": ["../../repos/bklit-ui/packages/ui/src/*"],
      "@bklitui/ui/charts": ["../../repos/bklit-ui/packages/ui/src/charts/index.ts"],
      "@bklitui/ui/charts/decimate-time-series": ["../../repos/bklit-ui/packages/ui/src/charts/decimate-time-series.ts"],
      "@migrated/charts": ["../../migrated/charts/index.ts"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "@number-flow/react": ["./node_modules/@number-flow/react/dist/index.d.ts"],
      "@tanstack/charts/svg/resources": ["../../repos/tanstack-charts/packages/charts-core/src/svg-resources.ts"],
      "d3-scale": ["./node_modules/@types/d3-scale/index.d.ts"],
      "d3-shape": ["./node_modules/@types/d3-shape/index.d.ts"],
      "d3-array": ["./node_modules/@types/d3-array/index.d.ts"],
      "d3-geo": ["./node_modules/@types/d3-geo/index.d.ts"],
      "geojson": ["./node_modules/@types/geojson/index.d.ts"],
      "@visx/zoom": ["./node_modules/@visx/zoom/lib/index.d.ts"],
      "@visx/zoom/lib/types": ["./node_modules/@visx/zoom/lib/types.d.ts"],
      "@visx/zoom/lib/util/matrix": ["./node_modules/@visx/zoom/lib/util/matrix.d.ts"],
      "react-dom": ["./node_modules/@types/react-dom/index.d.ts"],
      "react-dom/client": ["./node_modules/@types/react-dom/client.d.ts"],
      "@bklitui/icons": ["../../repos/bklit-ui/packages/icons/src/index.ts"],
      "@tanstack/charts": ["../../repos/tanstack-charts/packages/charts-core/src/index.ts"],
      "@tanstack/charts/*": ["../../repos/tanstack-charts/packages/charts-core/src/*.ts"],
      "@tanstack/react-charts": ["../../repos/tanstack-charts/packages/react-charts/src/index.ts"],
      "@tanstack/react-charts/*": ["../../repos/tanstack-charts/packages/react-charts/src/*.ts"],
      "d3-sankey": ["./node_modules/@types/d3-sankey/index.d.ts"]
    }
  },
  "include": ["src", "../data.ts", "../../qa/api-compat"]
}
